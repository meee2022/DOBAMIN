{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopamine-boutique",
  "account_id": "976bd8e7c24217500671163086e738bc",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dopamine-orders",
    "database_id": "e7b2532e-2d56-4ca6-96fb-6be5850d3184",
    "migrations_dir": "cloudflare/migrations"
  }],
  "triggers": {"crons": ["17 3 * * *"]}
}
