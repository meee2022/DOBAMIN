{
  "name": "dopamine",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-brand.cjs && expo export --platform web && node scripts/social-meta.cjs dist",
    "media:upload": "node scripts/upload-gallery.cjs",
    "deploy:cloudflare": "npm run build:web && wrangler deploy",
    "test:cloudflare": "node --test cloudflare/orders.test.mjs",
    "build:pages": "node scripts/build-pages.cjs",
    "deploy:pages": "npm run build:pages && cd cloudflare/pages && wrangler pages deploy --branch main",
    "build:brand": "node scripts/build-brand.cjs",
    "dev:api": "npm run build:web && wrangler d1 migrations apply dopamine-orders --local && wrangler dev --port 8787 --var DOPAMINE_ADMIN_KEY:test-key-only",
    "backup:orders": "wrangler d1 export dopamine-orders --remote --output backups/orders.sql",
    "format": "npx -y prettier@3.6.2 --write App.tsx App.web.tsx \"src/**/*.{ts,tsx}\" \"cloudflare/*.mjs\" src/web.css src/menu.css src/orders.css src/brand.css"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/antic-didone": "^0.4.1",
    "@expo-google-fonts/aref-ruqaa": "^0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "convex": "^1.46.0",
    "expo": "^57.0.9",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "wrangler": "^4.143.1"
  }
}
