{
  "name": "dopamine",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node scripts/social-meta.cjs dist",
    "orders:server": "node server/orders.mjs",
    "test:orders": "node --test server/orders.test.mjs",
    "media:upload": "node scripts/upload-gallery.cjs",
    "deploy:cloudflare": "npm run build:web && wrangler deploy",
    "test:cloudflare": "node --test cloudflare/orders.test.mjs",
    "build:pages": "node scripts/build-pages.cjs",
    "deploy:pages": "npm run build:pages && cd cloudflare/pages && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "convex": "^1.46.0",
    "expo": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "wrangler": "^4.143.1"
  }
}
