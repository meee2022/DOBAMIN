  "narrative": {
    "northStar": "A calm confectionery boutique",
    "overview": "The approved packaging identity carries into the website: light Nardo surfaces, graphite original heart-script logo, sage and powder-blue horizontal drybrush accents, olive and slate details. Deep sage concentrates attention on actions. Arabic/English typography, menu cards and ordering flows remain intact. Canonical values: branding/website-identity.json. The guide is available at /brand/.",
    "keyCharacteristics": [
      "Warm cream surfaces and caramel identity accents.",
      "Arabic literary display paired with restrained English serif.",
      "Product photography, fine rules, and generous spacing.",
      "Warm-white enclosed media cards with rounded corners and focused image enlargement."
    ],
    "rules": [
      {
        "name": "The Deep sage Action Rule",
        "body": "Use deep sage to identify actions, selected filters, and keyboard focus; preserve the warm neutral field around them.",
        "section": "colors"
      },
      {
        "name": "The Language Pairing Rule",
        "body": "Preserve the implemented Arabic and English family relationship and reading direction when extending a surface.",
        "section": "typography"
