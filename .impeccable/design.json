  "narrative": {
    "northStar": "A calm confectionery boutique",
    "overview": "Nardo surfaces, the supplied heart-script logo, and approved sunlit dessert photography establish a quiet boutique. Sage and powder blue carry the atmosphere; deep sage concentrates attention on actions and selected states. Editorial space, arched category frames and open product presentations give the existing identity room to breathe.\n\nArabic is the initial reading direction, with literary display lettering and generous text leading. English uses the established high-contrast serif. Operational forms and preparation schedules retain Arial and the brand palette. The implemented web surface is authoritative: `App.web.tsx` loads `src/boutique.css` after the earlier identity, storefront and section-photography styles. This 2026-11-06 record supersedes the earlier full-width overlay hero, square category frames and enclosed menu-card descriptions. It does not establish a native-app redesign.",
    "keyCharacteristics": [
      "Nardo surfaces, graphite text, sage actions and powder-blue section backgrounds.",
      "The original heart-script logo and established Arabic/English typography.",
      "Approved lifestyle photography framed by arches and restrained corners.",
      "Open product presentations, aligned actions, fine rules and generous editorial space."
    ],
    "rules": [
      {
        "name": "The Deep Sage Action Rule",
        "body": "Use deep sage to identify primary actions and selected filters; keep editorial text graphite and the surrounding canvas quiet.",
        "section": "colors"
      },
      {
        "name": "The Language Pairing Rule",
        "body": "Preserve the implemented Arabic and English family relationship and reading direction when extending a surface.",
        "section": "typography"
      },
      {
        "name": "The Operate Typography Rule",
        "body": "Use Arial for order forms, request records and preparation schedules in both languages; keep the boutique display pairing on editorial surfaces.",
        "section": "typography"
      },
      {
        "name": "The Open Product Rule",
        "body": "Keep menu photography, product copy and aligned actions visually connected on the page canvas without enclosing the entire product in a filled card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the original logo, approved palette, bilingual typography and reading direction.",
      "Do reuse approved sunlit menu and section photography, keeping its physical subjects and brush identity intact.",
      "Do use open product presentations, aligned actions, fine rules and sage/powder-blue tonal sections.",
      "Do provide visible keyboard focus, meaningful labels and reduced-motion behavior.",
      "Do pair every operational status color with written text and display Qatar time for scheduled requests."
    ],
    "donts": [
      "Don't replace the approved identity with a generic wordmark, new palette or new font system.",
      "Don't restore the superseded full-width overlay hero or enclosed gallery-card layout as the current storefront pattern.",
      "Don't spread arches, drybrush decoration or container shadows across every control and product.",
      "Don't restore beige, peach or pink backgrounds or plates in customer-facing menu photography.",
      "Don't turn unconfirmed prices, schedules or pending requests into production commerce claims."
    ]
  }
}
