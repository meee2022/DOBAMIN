      {
        "name": "The Operate Typography Rule",
        "body": "Use Arial for order forms, request records, and preparation schedules in both languages; keep the boutique display pairing on editorial surfaces. Operational headings are 32px at weight 500, reducing to 26px on mobile; fields use 14px labels, and status labels use 12px.",
        "section": "typography"
      },
      {
        "name": "The Enclosed Media Rule",
        "body": "Keep product and gallery imagery, bilingual names, and associated actions within offwhite cards with fine warm borders and 14px corners; retain shadow-free surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied logo and brand palette.",
      "Do retain Arabic and English reading direction and type pairing.",
      "Do use enclosed offwhite product and gallery cards, fine rules, and sage and powder-blue tonal sections.",
      "Do provide visible keyboard focus and honor reduced-motion preference.",
      "Do pair every operational status color with a written label and display Qatar time for preparation dates."
