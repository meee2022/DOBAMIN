  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Deep sage collection and bag action.",
      "html": "<button class=\"ds-button\">اكتشف لحظتك الحلوة</button>",
      "css": ".ds-button{font-family:Amiri,serif;font-size:16px;min-height:51px;padding:12px 25px;display:inline-flex;align-items:center;justify-content:center;gap:30px;border:0;border-radius:3px;cursor:pointer;transition:background .25s,transform .35s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover{transform:translateY(-2px)}.ds-button:focus-visible,.ds-add:focus-visible,.ds-nav a:focus-visible,.ds-tabs button:focus-visible{outline:2px solid var(--accent,#435342);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-button{background:var(--accent,#435342);color:var(--white,#FFFFFF)}.ds-button:hover{background:#344334}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined gifting action.",
      "html": "<button class=\"ds-button\">اكتشف هدايا دوبامين</button>",
      "css": ".ds-button{font-family:Amiri,serif;font-size:16px;min-height:51px;padding:12px 25px;display:inline-flex;align-items:center;justify-content:center;gap:30px;border:0;border-radius:3px;cursor:pointer;transition:background .25s,transform .35s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover{transform:translateY(-2px)}.ds-button:focus-visible,.ds-add:focus-visible,.ds-nav a:focus-visible,.ds-tabs button:focus-visible{outline:2px solid var(--accent,#435342);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-button{background:transparent;color:var(--ink,#454B4B);border:1px solid var(--ink,#454B4B)}.ds-button:hover{background:var(--surface,#E9EDE6)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Text navigation with a thin hover underline.",
      "html": "<nav class=\"ds-nav\" dir=\"rtl\"><a href=\"#collection\">المجموعة</a><a href=\"#story\">حكايتنا</a><a href=\"#gifting\">فن الإهداء</a></nav>",
      "css": ".ds-nav{display:flex;gap:30px;font-family:Amiri,serif;font-size:16px;color:var(--ink,#454B4B)}.ds-nav a{position:relative;color:inherit;text-decoration:none}.ds-nav a:after{content:'';position:absolute;bottom:-6px;inset-inline-start:0;width:100%;height:1px;background:var(--accent,#435342);transform:scaleX(0);transform-origin:right;transition:transform .3s}.ds-nav a:hover:after{transform:scaleX(1)}.ds-button:focus-visible,.ds-add:focus-visible,.ds-nav a:focus-visible,.ds-tabs button:focus-visible{outline:2px solid var(--accent,#435342);outline-offset:5px}"
    },
    {
      "name": "Collection Filters",
      "kind": "nav",
      "description": "Pressed state is expressed by a deep sage underline.",
      "html": "<div class=\"ds-tabs\" dir=\"rtl\" role=\"group\" aria-label=\"Filter collection\"><button aria-pressed=\"true\">كل اللحظات</button><button aria-pressed=\"false\">حلا يومك</button><button aria-pressed=\"false\">للمشاركة</button></div>",
      "css": ".ds-tabs{display:flex;gap:30px;border-bottom:1px solid var(--line,#D4DAD1)}.ds-tabs button{font-family:Amiri,serif;background:none;border:0;border-bottom:2px solid transparent;padding:12px 3px 16px;color:var(--muted,#5F6963);font-size:17px;cursor:pointer}.ds-tabs button[aria-pressed=true]{color:var(--accent,#435342);border-color:var(--accent,#435342)}.ds-button:focus-visible,.ds-add:focus-visible,.ds-nav a:focus-visible,.ds-tabs button:focus-visible{outline:2px solid var(--accent,#435342);outline-offset:5px}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Compact lower-center confirmation surface.",
      "html": "<div class=\"ds-toast\" role=\"status\">أضفنا لحظة حلوة إلى حقيبتك</div>",
      "css": ".ds-toast{background:var(--ink,#454B4B);color:var(--white,#FFFFFF);padding:12px 24px;display:inline-flex;gap:12px;align-items:center;border-radius:4px;font-family:Amiri,serif;font-size:16px}"
    },
    {
      "name": "Operational Field",
      "kind": "input",
      "refersTo": "order-field",
      "description": "Visible label and native field with caramel focus.",
      "html": "<label class=\"ds-field\">Full name<input autocomplete=\"name\" required></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:14px/1.7 Arial,sans-serif;color:var(--ink,#454B4B)}.ds-field input{font:inherit;border:1px solid var(--line,#D4DAD1);border-radius:4px;padding:12px;background:var(--white,#FFFFFF);color:var(--ink,#454B4B);min-height:45px;caret-color:var(--accent,#435342)}.ds-field input:focus{outline:2px solid var(--primary,#A8B798);outline-offset:2px}"
    },
    {
      "name": "Order Statuses",
      "kind": "chip",
      "refersTo": "status-pending",
      "description": "Written semantic status labels; confirmed shares preparing, completed shares ready.",
      "html": "<div class=\"ds-statuses\"><span class=\"ds-status ds-pending\">Pending</span><span class=\"ds-status ds-preparing\">Preparing</span><span class=\"ds-status ds-ready\">Ready</span><span class=\"ds-status ds-cancelled\">Cancelled</span></div>",
      "css": ".ds-statuses{display:flex;gap:8px;flex-wrap:wrap}.ds-status{font:12px/1.65 Arial,sans-serif;padding:5px 10px;border-radius:20px;white-space:nowrap}.ds-pending{background:#F0EEDD;color:#675C31}.ds-preparing{background:#E4EDF1;color:#465E6A}.ds-ready{background:#E5ECDE;color:#3F5B43}.ds-cancelled{background:#F2E7E5;color:#88453E}"
    },
    {
      "name": "Product Card",
      "kind": "card",
      "refersTo": "product-card",
      "description": "Paired image-frame specimen with an enclosed bilingual body; actual product assets are supplied by the catalog.",
      "html": "<article class=\"ds-product\" dir=\"rtl\"><div class=\"ds-pair\"><div>بتغليف دوبامين</div><div>على الطبق</div></div><div class=\"ds-copy\"><span class=\"ds-type\">تارت</span><h3>تارت فستق</h3><p dir=\"ltr\">Pistachio tarte</p><div class=\"ds-bottom\"><span>السعر عند التأكيد</span><button class=\"ds-media-add\">أضف للحقيبة</button></div></div></article>",
      "css": ".ds-product{font-family:Amiri,serif;color:var(--ink,#454B4B);background:var(--white,#FFFFFF);border:1px solid var(--line,#D4DAD1);border-radius:14px;overflow:hidden;max-width:420px;transition:border-color .25s}.ds-product:hover{border-color:var(--primary,#A8B798)}.ds-pair{display:grid;grid-template-columns:1fr 1fr;gap:3px;background:var(--surface,#E9EDE6)}.ds-pair div{aspect-ratio:1;display:grid;place-items:end center;padding:10px 4px;font-size:13px;color:var(--muted,#5F6963)}.ds-copy{padding:17px 22px 22px}.ds-type{font-size:12px;color:var(--muted,#5F6963);border-bottom:1px solid var(--line,#D4DAD1);padding-bottom:4px}.ds-copy h3{font-size:24px;line-height:1.55;font-weight:400;margin:10px 0 0}.ds-copy p{font:14px/1.6 \"Antic Didone\",serif;color:var(--muted,#5F6963);margin:6px 0 0}.ds-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid var(--line,#D4DAD1);padding-top:17px;margin-top:22px;font-size:13px}.ds-media-add{font:14px Amiri,serif;border:0;background:var(--accent,#435342);color:var(--white,#FFFFFF);border-radius:5px;min-height:44px;padding:8px 13px;cursor:pointer}.ds-media-add:hover{background:#344334}.ds-media-add:focus-visible,.ds-filter:focus-visible,.ds-photo-button:focus-visible{outline:2px solid var(--accent,#435342);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-product{transition:none}}"
    },
    {
      "name": "Gallery Card",
      "kind": "card",
      "refersTo": "gallery-card",
      "description": "Single square image-frame specimen with bilingual title and warm border.",
      "html": "<article class=\"ds-gallery-card\"><div class=\"ds-gallery-frame\"></div><div class=\"ds-gallery-copy\"><span>Packaging concepts</span><h2>Blooming Flower Box</h2><p dir=\"rtl\">بوكس زهرة متفتح</p></div></article>",
      "css": ".ds-gallery-card{max-width:420px;background:var(--white,#FFFFFF);color:var(--ink,#454B4B);border:1px solid var(--line,#D4DAD1);border-radius:14px;overflow:hidden;transition:border-color .3s;font-family:\"Antic Didone\",serif}.ds-gallery-card:hover{border-color:var(--primary,#A8B798)}.ds-gallery-frame{aspect-ratio:1;background:var(--surface,#E9EDE6)}.ds-gallery-copy{padding:21px 24px 26px}.ds-gallery-copy span{font-size:12px;color:var(--muted,#5F6963)}.ds-gallery-copy h2{font-size:25px;line-height:1.5;font-weight:400;margin:8px 0 0}.ds-gallery-copy p{font-family:Amiri,serif;font-size:14px;line-height:1.6;color:var(--muted,#5F6963);margin:9px 0 0}"
